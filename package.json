{
  "name": "deskwizard",
  "version": "0.1.0",
  "private": true,
  "description": "Build a Debian 13 + Sway + Waybar desktop setup and export a one-line install command.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "prepare": "node scripts/render-wallpapers.mjs",
    "render-wallpapers": "node scripts/render-wallpapers.mjs",
    "validate": "node scripts/validate.mjs",
    "check-secrets": "node scripts/check-secrets.mjs",
    "check-catalog-refs": "node scripts/check-catalog-refs.mjs",
    "check-support": "node scripts/check-support.mjs",
    "check-manifest": "node scripts/check-manifest.mjs",
    "new-tool": "node scripts/new-tool.mjs",
    "new-variant": "node scripts/new-variant.mjs",
    "build-catalog": "node scripts/build-catalog.mjs",
    "generate-install": "node scripts/generate-install.mjs",
    "dev": "vite --config vite.config.js",
    "build": "node scripts/render-wallpapers.mjs && node scripts/validate.mjs && node scripts/build-catalog.mjs && node scripts/generate-install.mjs && vite build --config vite.config.js"
  },
  "dependencies": {
    "yaml": "^2.5.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "ajv": "^8.17.1",
    "vite": "^5.4.0"
  }
}
