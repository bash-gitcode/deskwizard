{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "palette.schema.json",
  "title": "Palette",
  "type": "object",
  "required": ["id", "name", "mode", "default", "tokens"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["dark", "light"] },
    "default": { "type": "boolean" },
    "tokens": {
      "type": "object",
      "required": ["bg", "surface", "fg", "muted", "accent", "accent2", "warn", "error", "font_ui", "font_mono"],
      "additionalProperties": false,
      "properties": {
        "bg": { "$ref": "#/$defs/hex" },
        "surface": { "$ref": "#/$defs/hex" },
        "fg": { "$ref": "#/$defs/hex" },
        "muted": { "$ref": "#/$defs/hex" },
        "accent": { "$ref": "#/$defs/hex" },
        "accent2": { "$ref": "#/$defs/hex" },
        "warn": { "$ref": "#/$defs/hex" },
        "error": { "$ref": "#/$defs/hex" },
        "font_ui": { "type": "string", "pattern": "^[A-Za-z][A-Za-z -]*$" },
        "font_mono": { "type": "string", "pattern": "^[A-Za-z][A-Za-z -]*$" }
      }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" }
  }
}
