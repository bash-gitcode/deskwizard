{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "distro.schema.json",
  "title": "Distro",
  "type": "array",
  "minItems": 1,
  "items": {
    "type": "object",
    "required": ["id", "name", "status", "support"],
    "additionalProperties": false,
    "properties": {
      "id": { "type": "string", "pattern": "^[a-z]+[0-9]*$" },
      "name": { "type": "string", "minLength": 1 },
      "status": { "enum": ["available", "coming_soon"] },
      "support": { "enum": ["verified-vm", "package-checked", "community"] },
      "os_release": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "ID": { "type": "string" },
          "VERSION_ID": { "type": "string" }
        }
      }
    }
  }
}
