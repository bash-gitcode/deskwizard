{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "variant.schema.json",
  "title": "Variant meta",
  "type": "object",
  "required": ["id", "name", "good_for", "requires", "screenshot"],
  "additionalProperties": false,
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "name": { "type": "string", "minLength": 1 },
    "good_for": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 3 } },
    "requires": { "type": "array", "items": { "type": "string" } },
    "options": {
      "type": "object",
      "required": ["height", "position"],
      "additionalProperties": false,
      "properties": {
        "height": { "type": "integer", "minimum": 16, "maximum": 96 },
        "position": { "enum": ["top", "bottom"] }
      }
    },
    "wallpaper": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.png$" },
    "screenshot": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.(svg|png|webp)$" }
  }
}
