// Waybar config: glass (deskwizard variant 04).
// Top bar with a translucent background. Colors live in style.css.
{
  "layer": "top",
  "position": "top",
  "height": 30,
  "spacing": 10,
  "modules-left": ["sway/workspaces"],
  "modules-center": ["clock"],
  "modules-right": ["network", "pulseaudio", "battery", "tray"],

  "clock": {
    "format": "{:%H:%M}",
    "tooltip-format": "{:%A %d %B %Y}"
  },
  "network": {
    "format-wifi": "wifi {signalStrength}%",
    "format-ethernet": "eth",
    "format-disconnected": "offline"
  },
  "pulseaudio": {
    "format": "vol {volume}%",
    "format-muted": "muted"
  },
  "battery": {
    "format": "bat {capacity}%",
    "states": { "warning": 30, "critical": 15 }
  },
  "tray": {
    "spacing": 10
  }
}
