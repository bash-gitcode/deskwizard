# mako notification config (deskwizard variant: compact).
# Colors come from your palette.
anchor=top-right
width=260
margin=10
padding=12
border-size=1
border-radius=4
background-color=$surface
text-color=$fg
border-color=$accent
font=$font_ui 11
default-timeout=3000
max-visible=5

[urgency=low]
border-color=$muted

[urgency=high]
border-color=$error
default-timeout=0
